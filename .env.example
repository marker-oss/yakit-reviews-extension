# ---- Database ----
# sqlite (default) or postgres
REVIEWS_DB_DRIVER=sqlite
# For sqlite in Docker this is forced to /data/reviews.db by docker-compose.
# For postgres: host=... user=... password=... dbname=... port=5432 sslmode=disable
# REVIEWS_DB_DSN=/data/reviews.db

# ---- Sync schedule (used by `serve --with-sync`) ----
REVIEWS_SYNC_INTERVAL=1h
REVIEWS_SYNC_BACKFILL_MONTHS=12
REVIEWS_SYNC_OVERLAP=1h

# ---- Logging ----
REVIEWS_LOG_LEVEL=info
REVIEWS_LOG_FORMAT=json
# Local HTTP preview only. Leave empty/disabled behind HTTPS.
REVIEWS_INSECURE_COOKIES=1

# ---- Site / widget ----
REVIEWS_SITE_PRODUCT_URL_TEMPLATE=https://example.com/search?query={seller_article_url}
# docker-compose overrides this to /data/product-links.json.
REVIEWS_SITE_PRODUCT_LINKS=data/product-links.json

# Shop origin(s) allowed to fetch reviews data cross-origin (CORS). REQUIRED for
# the embedded widget to load data from a different host than your shop.
# Your shop's origin, scheme included, no trailing slash. Comma-separate several
# (e.g. apex + www). Leave empty only for same-origin or local testing.
REVIEWS_SHOP_ORIGIN=https://myshop.example
# Public host that serves the widget/data (used by the VPS Caddyfile only).
REVIEWS_PUBLIC_DOMAIN=reviews.myshop.example
# Shop sitemap crawled to map product pages to seller articles. Used by the
# admin "Обновить каталог товаров" button and the `discover-site-urls` command.
# Defaults to the first REVIEWS_SHOP_ORIGIN + "/sitemap.xml" if left empty.
REVIEWS_SITE_SITEMAP_URL=https://myshop.example/sitemap.xml
# Contact shown in the privacy policy for data-subject (152-ФЗ) requests.
REVIEWS_PRIVACY_CONTACT=

# ---- Wildberries ----
# Enable after filling REVIEWS_WB_TOKEN.
REVIEWS_WB_ENABLED=false
REVIEWS_WB_TOKEN=

# ---- Yandex Market ----
# Enable after filling REVIEWS_YM_API_KEY and REVIEWS_YM_BUSINESS_ID.
REVIEWS_YM_ENABLED=false
REVIEWS_YM_API_KEY=
REVIEWS_YM_BUSINESS_ID=
# REVIEWS_YM_CAMPAIGN_ID=

# ---- Ozon (disabled by default) ----
REVIEWS_OZON_ENABLED=false
REVIEWS_OZON_CLIENT_ID=
REVIEWS_OZON_API_KEY=
